---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SECTION_META } from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const all = await getCollection('articles', ({ data }) => !data.draft);
  return Object.keys(SECTION_META).map((section) => ({
    params: { section },
    props: {
      posts: all.filter((p) => p.data.section === section).sort((a, b) => b.data.date - a.data.date),
      meta: SECTION_META[section],
    },
  }));
}

const { posts, meta } = Astro.props;
const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title={meta.label} description={`${meta.label} coverage from Sport Spectator.`}>
  <div class="wrap index">
    <span class="eyebrow" style={`color:var(--${meta.color})`}>Section</span>
    <h1>{meta.label}</h1>
    {posts.length === 0
      ? <p style="color:var(--cream-45)">No stories in this section yet.</p>
      : <ul class="feed">{posts.map((p) => (
          <li><a href={`/articles/${p.id}/`}>
            <h2>{p.data.title}</h2>
            {p.data.dek && <p>{p.data.dek}</p>}
            <span class="meta">{p.data.author} · {fmt(p.data.date)}</span>
          </a></li>
        ))}</ul>}
  </div>
</Base>
